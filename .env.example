# ---------------------------------------------------------------------------
# AgriSense AI - example environment configuration
# Copy to .env and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Backend (Python / FastAPI) ---------------------------------------------
# PostgreSQL connection string for production / docker-compose.
# For quick local development, SQLite is used when DATABASE_URL is unset.
DATABASE_URL=postgresql+psycopg2://agrisense:agrisense@localhost:5432/agrisense

# Secret used to sign JWT access tokens. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_DAYS=7

# Demo account credential (public by design; override or unset to disable
# the seeded demo user in production).
DEMO_EMAIL=demo@agrisense.ai
DEMO_PASSWORD=Demo@1234

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded crop images are stored (relative to the backend directory).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# --- External API integrations (all optional; DB fallbacks apply) -----------
# Open-Meteo-compatible weather endpoint (no API key required by default).
WEATHER_API_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=

# AGMARKNET-style mandi price feed. When empty, market data is served from
# the local database (response source: "mandi-db").
MANDI_API_URL=
MANDI_API_KEY=

# External conversational API for the farmer assistant. When empty the
# built-in rule-based assistant answers. Keys stay backend-only.
ASSISTANT_API_URL=
ASSISTANT_API_KEY=

# --- Caching / rate limiting -------------------------------------------------
# Redis connection for shared caching. Empty -> process-local TTL cache.
REDIS_URL=

# Fixed-window rate limits (requests per minute per IP).
RATE_LIMIT_AUTH=30
RATE_LIMIT_ASSISTANT=20
RATE_LIMIT_UPLOADS=30

# --- Frontend (React / Vite) -------------------------------------------------
# Base URL of the versioned API the frontend talks to.
VITE_API_BASE_URL=http://localhost:8000/api/v1
